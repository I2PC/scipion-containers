# ----------------------------
# Launch container
# ----------------------------
# Only add the X11/GUI binds when a display is actually available. On headless
# cluster compute nodes DISPLAY is unset, so the GUI flags (and the bind of
# /tmp/.X11-unix, which may not exist there) are skipped. The same launcher
# therefore works both on a workstation and under a batch/SLURM allocation.
if [ -n "$DISPLAY" ]; then
    RUN_GUI_CMD=("${GUI_CMD[@]}")
else
    RUN_GUI_CMD=()
    echo "No DISPLAY detected: launching Scipion in headless mode (no GUI)."
fi

echo "Launching Scipion container for $CONTAINER_FLAVOUR"
"${LAUNCH_CMD[@]}" "${RUN_GUI_CMD[@]}" "$SIF_PATH" /scipion/scipion3 "$@"
