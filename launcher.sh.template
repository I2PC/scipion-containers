#CLUSTER_MPI_BINDIR="$CLUSTER_MPI_PREFIX/bin"
#CLUSTER_MPI_LIBDIR="$CLUSTER_MPI_PREFIX/lib/x86_64-linux-gnu"   # module-style: "$CLUSTER_MPI_PREFIX/lib"
#
# -- OpenMPI 4.x (ORTE): verify the versioned names with: ls "$CLUSTER_MPI_LIBDIR"
#    (pmix2 is a DIRECTORY: libpmix.so.2 is a symlink into it, so bind it too).
