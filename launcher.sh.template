#SCIPMPI_CORELIBS="libmpi.so.40 libmpi_cxx.so.40 libopen-rte.so.40 libopen-pal.so.40"
#SCIPMPI_PMIXLIBS="libpmix.so.2 libevent_core-2.1.so.7 libhwloc.so.15"
