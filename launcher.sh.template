  apptainer exec --nv --containall
  --env SCIPION_USER_DATA="$SCIPION_PROJDIR"
  --env SCIPION_TESTS="$SCIPION_LOCAL_TESTS"
  --bind "$SCIPION_PROJDIR/logs:/logs"
  --bind /run
  --bind /etc/resolv.conf
  --bind "$SCIPION_DATADIR:/data"
  --bind "$SCIPION_PROJDIR"
  --bind "$SCIPION_LOCAL_TESTS"
  $SCIPCRYOSPARC_CMD
  $SCIPCRYOASSESS_CMD
  $SCIPPHENIX_CMD
  $SCIPSLURM_CMD
  $SCIPCHIMERA_CMD
  $SCIP_CACHES_CMD
  $SCIPMPI_CMD
)

GUI_CMD=(
  --env DISPLAY="$DISPLAY"
