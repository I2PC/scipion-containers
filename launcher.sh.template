#### USER CONFIGURABLE VARIABLES
###
###

### CONTAINER VERSION AND FLAVOUR
# You can check all existing versions of the images in our GitHub page. 
# "latest" is always the recommended stable image.
CONTAINER_VERSION="latest"
# Available flavours are: base, spa, tomo, full
CONTAINER_FLAVOUR="spa"
### END #######################################################################

### CLUSTER SPECIFIC
# You can add your cluster-specific commands here
#PREPARE_ENV="module load XXX"
$PREPARE_ENV
PREPARE_SCREEN="xhost +local: "
$PREPARE_SCREEN
# CLUSTER END
### END #######################################################################


### CHIMERAX 
# Point the container to the chimerax folder i.e (/home/chimerax-X.X.X being X.X.X the chimeraX version)
# Important note: the folder must have an executable called exaclty "ChimeraX". You can do it with a symbolic link.
CHIMERA_HOME="path/to/your/local/chimerax-X.X.X"
# Update the chimera version (the X.X.X part in the line below) of the chimera location in the container 
export CHIMERA_LOCATION="/scipion/software/em/chimerax-X.X.X"

# UNCOMMENT THIS LINE WHEN USING CHIMERAX
# SCIPCHIMERA_CMD=" --bind $CHIMERA_HOME:$CHIMERA_LOCATION --env CHIMERA_HOME=$CHIMERA_LOCATION"
### CHIMERAX END
### END #######################################################################


### CRYOSPARC
# CS will work only if the container has direct access to the cryosparcm binary
# Point the container to the folder that contains the cryosparc_master folder
export CRYOSPARC_HOME="/route/to/cryosparc_folder"
export CRYOSPARC_PROJECTS_DIR="/route/to/cs_projects"
export CRYOSPARC_USER="email@something.com"
export CRYOSPARC_PASSWORD="password"

# UNCOMMENT THIS LINE WHEN USING CRYOSPARC
#SCIPCRYOSPARC_CMD=" --bind $CRYOSPARC_HOME --bind $CRYOSPARC_PROJECTS_DIR --env CRYOSPARC_HOME=$CRYOSPARC_HOME --env CRYOSPARC_USER=$CRYOSPARC_USER --env CRYOSPARC_PASSWORD=$CRYOSPARC_PASSWORD "
### CRYOSPARC END
### END #######################################################################


### CRYOASSESS
# Point to your CryoAssess models folder
SCIPCRYOASSESS_MODELS="/route/to/your/cryoassess_models_folder"

# UNCOMMENT THIS LINE WHEN USING CRYOASSESS
#$SCIPCRYOASSESS_CMD=" --bind $SCIPCRYOASSESS_MODELS:/scipion/software/em/cryoassess_models "
### CRYOASSESS END
### END #######################################################################


### PHENIX
# Point to your PHENIX installation, as Scipion will not download the binaries
SCIPPHENIX_FOLDER="/route/to/your/phenix_folder"

# UNCOMMENT THIS LINE WHEN USING PHENIX
#SCIPPHENIX_CMD=" --bind $SCIPPHENIX_FOLDER --env PHENIX_HOME=$SCIPPHENIX_FOLDER "
### PHENIX END
### END #######################################################################


### STORAGE DIRECTORIES
# The datadir will be used to input the RAW data used for processing, ie movies/tiltseries
SCIPION_DATADIR="/path/to/your/data/folder"
# The projdir will house Scipion's project and all of its intermediate data
SCIPION_PROJDIR="/path/to/your/ScipionUserData"
# Creatings logs directory
mkdir -p $SCIPION_PROJDIR/logs
### END STORAGE
### END #######################################################################



### SLURM
# Modify the variables to point to your actual SLURM installation 
# Or just ignore if not using SLURM
SCIPSLURM_HOSTSCONF="/path/to/your/hosts.conf"
SCIPSLURM_BIN="/usr/bin"
SCIPSLURM_BASE="/etc/slurm-llnl"
SCIPSLURM_LIB="/var/lib/slurm-llnl"
# UNCOMMENT THIS LINE IF YOUR SCIPSLURM_LIB HAS MORE LIBRARIES APPART FROM THE SLURM ONE
#SCIPSLURM_LIB_DEPENDENCIES="--bind /lib/x86_64-linux-gnu/libc.so.* --bind /lib/x86_64-linux-gnu/libm.so.* --bind /lib/x86_64-linux-gnu/libresolv.so.* --bind /lib/x86_64-linux-gnu/ld-linux-x86-64.so.*"
SCIPSLURM_PLUGINS="/usr/lib/x86_64-linux-gnu/slurm-wlm/"
# Usual locations (check your specific case)
# BIN -> /usr/bin, /opt/slurm/bin, /bin
# BASE -> /etc/slurm-llnl, /etc/slurm
# LIB -> /var/lib/slurm-llnl (ubuntu apt), /var/lib/slurm (ubuntu sources), /usr/lib64/slurm
# LIB_DEPENDENCIES -> ubuntu: /lib/x86_64-linux-gnu/libc.so.*, /lib/x86_64-linux-gnu/libm.so.*, /lib/x86_64-linux-gnu/libresolv.so.*, /lib/x86_64-linux-gnu/ld-linux-x86-64.so.* 
#                     CentOS: /lib64/libc.so.*, /lib64/libm.so.*, /lib64/libresolv.so.*, /lib64/ld-linux-x86-64.so.*
# PLUGINS -> /usr/lib/x86_64-linux-gnu/slurm-wlm/ (ubuntu apt), /usr/lib64/slurm (CentOS)
###
# DONT TOUCH THESE
SCIPSLURM_JOBS=" --bind $SCIPSLURM_BIN/sbatch --bind $SCIPSLURM_BIN/srun --bind $SCIPSLURM_BIN/scancel --bind $SCIPSLURM_BIN/salloc "
SCIPSLURM_CTRL=" --bind $SCIPSLURM_BIN/squeue --bind $SCIPSLURM_BIN/sinfo \
                 --bind $SCIPSLURM_BIN/scontrol --bind $SCIPSLURM_BIN/sstat --bind $SCIPSLURM_BIN/sacct "
SCIPSLURM_CONF=" --bind $SCIPSLURM_BASE --bind $SCIPSLURM_HOSTSCONF:/scipion/config/hosts.conf "
SCIPSLURM_LIBS="${SCIPSLURM_LIB:+--bind $SCIPSLURM_LIB} ${SCIPSLURM_LIB_DEPENDENCIES:+--bind $SCIPSLURM_LIB_DEPENDENCIES} ${SCIPSLURM_PLUGINS:+--bind $SCIPSLURM_PLUGINS} "
# UNCOMMENT THIS LINE WHEN USING SLURM
#SCIPSLURM_CMD=" $SCIPSLURM_JOBS $SCIPSLURM_CTRL $SCIPSLURM_CONF $SCIPSLURM_LIBS "
# END OF SLURM CONFIGURATION VARIABLES
### END #######################################################################

### Message Passing Interface (MPI)
# Many programs (such as Relion & Xmipp) require MPI
# Simple tasks such as extract particles will fail if this is not configured
# LIB is usually /usr/lib/x86_64-linux-gnu/openmpi (Ubuntu-APT) or /usr/lib64/openmpi/ (CentOS-YUM)
# Depending on your system, it might also be in /opt or even be mpich instead of openmpi
# If in doubt, check with your nearest IT manager
SCIPMPI_LIB=" /usr/lib/x86_64-linux-gnu/openmpi "
SCIPMPI_CMD=" --bind $SCIPMPI_LIB --bind /tmp "
# END OF MPI CONFIGURATION VARIABLES
### END #######################################################################

### Known container environment workarounds (apply on every launch, no per-protocol fix needed)
# These paths are baked into the apptainer-spa image itself (not host-specific),
# so they are valid on any deployment of the same image. See workflow_solved.md
# bugs 6, 7 and 9 for the full diagnosis of each one.
#
# Bug 6: launcher.sh binds the HOST's OpenMPI (SCIPMPI_CMD below) over the
# container's own, for real multi-node clusters. On a single workstation
# without a matching host glibc, this breaks 'mpirun' for Relion's MPI
# protocols ("mpirun: symbol lookup error: ... undefined symbol: PMIx_Info_create").
# Point Relion's MPI launcher at a self-contained conda env's mpirun instead.
SCIP_PARALLEL_COMMAND_RELION="/opt/miniforge3/envs/cryolo-1.9.9/bin/mpirun -np %(JOB_NODES)d %(COMMAND)s"

# Bug 7: the 'xmipp_MicCleaner' conda env (used by XmippProtDeepMicrographScreen)
# is missing libgfortran.so.4 in its own lib dir (only has .so.5). The image
# happens to bundle a compatible copy elsewhere (used by other envs) - add it
# to LD_LIBRARY_PATH so scipy/skimage can find it without touching any envs
# that already resolve their own gfortran correctly (LD_LIBRARY_PATH is only
# consulted as a fallback after RPATH/RUNPATH).
SCIP_EXTRA_LD_LIBRARY_PATH="/opt/miniforge3/pkgs/libgfortran4-7.5.0-h14aa051_20/lib"

# Bug 9: XmippProtClassifyPcaStreaming's own code wipes LD_LIBRARY_PATH to ''
# before running its PyTorch/CUDA step (to isolate that conda env), which also
# erases the NVIDIA driver paths --nv injects, breaking torch.cuda entirely
# ("Found no NVIDIA driver") and, once that's preloaded, cuBLAS init
# ("CUBLAS_STATUS_NOT_INITIALIZED", needs the JIT compiler too). LD_PRELOAD
# survives that wipe (the protocol code never touches it), so preload the
# driver libs by absolute path - harmless for any process that doesn't need
# CUDA, since these are stable, uniquely-named NVIDIA driver libraries.
SCIP_LD_PRELOAD_NVIDIA="/.singularity.d/libs/libcuda.so.1:/.singularity.d/libs/libnvidia-ml.so.1:/.singularity.d/libs/libnvidia-ptxjitcompiler.so.1"
### END KNOWN WORKAROUNDS #####################################################

### Apptainer directories configuration
# Define where Apptainer stores data:
# - APPTAINER_CACHEDIR: base directory where Apptainer will create its internal cache folder (e.g. ~/containers)
# - APPTAINER_TMPDIR: directory for temporary files created during image builds 
# We recommend changing the cachedir to a shared location if you are in a shared/cluster environment
# This cache will effectively store the images themselves, make sure it has enough space (~300GB)
export APPTAINER_CACHEDIR="/path/to/your/apptainer/cache"
export APPTAINER_TMPDIR="/path/to/your/apptainer/tmp"
# Create directories if they don’t exist
mkdir -p "$APPTAINER_CACHEDIR" "$APPTAINER_TMPDIR"

###
###
#### END OF USER CONFIGURABLE VARIABLES

### Apptainer instance
# All launcher.sh invocations for a given flavour share ONE persistent Apptainer
# instance instead of each starting/tearing down its own container. This matters
# for 'scipion3 template': it launches the actual protocol scheduler and the
# project GUI as *detached* background subprocesses without waiting for them
# (scipion-app/scipion/scripts/kickoff.py, createProjectFromWorkflow()). With a
# one-shot 'apptainer exec', those subprocesses get killed the moment the
# invoked command returns, leaving protocols stuck as "scheduled" forever.
# The instance keeps running (and keeps those subprocesses alive) until you
# stop it yourself with:
#   bash launcher.sh --stop-instance
INSTANCE_NAME="scipion-$CONTAINER_FLAVOUR"

# Do not touch below here unless you know what you are doing!

# apptainer instance start/stop needs to talk to the user's systemd --user
# session over D-Bus to manage the instance's cgroup (rootless cgroups v2).
# DBUS_SESSION_BUS_ADDRESS may already point elsewhere (e.g. the desktop
# session bus under a GNOME login), which makes it fail with
# "could not detect the OwnerUID". Point it explicitly at the systemd user
# bus if that socket exists.
if [[ -S "/run/user/$(id -u)/bus" ]]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi

# Let the user stop the persistent instance without touching anything else
if [[ "$1" == "--stop-instance" ]]; then
    echo "Stopping Apptainer instance '$INSTANCE_NAME'..."
    apptainer instance stop "$INSTANCE_NAME"
    exit $?
fi

echo "Preparing to launch Scipion Container"
REGISTRY="rinchen.cnb.csic.es"
IMAGE="apptainer-$CONTAINER_FLAVOUR"
APPTAINER_CACHEDIR="${APPTAINER_CACHEDIR:-$HOME/.apptainer}"
mkdir -p "$APPTAINER_CACHEDIR"

# Paths
VERSION_FILE="$APPTAINER_CACHEDIR/$IMAGE:latest.version"
LOG_FILE="$APPTAINER_CACHEDIR/container_downloads.log"
if [[ "$CONTAINER_VERSION" == "latest" ]]; then
    SIF_PATH="$APPTAINER_CACHEDIR/$IMAGE:latest.sif"
else
    SIF_PATH="$APPTAINER_CACHEDIR/$IMAGE:$CONTAINER_VERSION.sif"
fi

UPDATE_NEEDED=0

# ----------------------------
# Fetch remote tags and latest numeric version
# ----------------------------
TAGS=$(curl -sf -u guest:guest "https://$REGISTRY/v2/scipion/$IMAGE/tags/list" | jq -r '.tags[]')
CURL_STATUS=$?
LATEST_NUMERIC=$(echo "$TAGS" | grep -E '^[0-9]+$' | sort -V | tail -n1)

# Read installed latest numeric version
INSTALLED_VERSION=""
[[ -f "$VERSION_FILE" ]] && INSTALLED_VERSION=$(cat "$VERSION_FILE")

if [[ $CURL_STATUS -ne 0 || -z "$LATEST_NUMERIC" ]]; then
    echo "Warning: could not reach the registry ($REGISTRY) to check for updates (network issue or an expired/invalid TLS certificate on the server)."
    if [[ -n "$INSTALLED_VERSION" || -f "$SIF_PATH" ]]; then
        echo "Continuing with the locally installed image."
        LATEST_NUMERIC="$INSTALLED_VERSION"
    else
        echo "No local image found either. Fix connectivity to $REGISTRY and try again."
        exit 1
    fi
fi

# ----------------------------
# Decide whether to download/update
# ----------------------------
if [[ "$CONTAINER_VERSION" == "latest" ]]; then
    if [[ "$INSTALLED_VERSION" != "$LATEST_NUMERIC" ]]; then
        echo "A newer 'latest' image exists on the server:"
        echo " - Installed latest = $INSTALLED_VERSION"
        echo " - Remote latest    = $LATEST_NUMERIC"
        read -p "Do you want to download it? Y/n: " -r
        if [[ $REPLY =~ ^[Yy]$ || -z $REPLY ]]; then
            UPDATE_NEEDED=1
        else
            echo "Using local version of latest ($INSTALLED_VERSION)."
        fi
    else
        echo "Latest version is up to date (numeric tag $INSTALLED_VERSION)."
    fi
else
    if [[ ! -f "$SIF_PATH" ]]; then
        echo "Requested numeric version $CONTAINER_VERSION not found locally."
        read -p "Do you want to download it? Y/n: " -r
        if [[ $REPLY =~ ^[Yy]$ || -z $REPLY ]]; then
            UPDATE_NEEDED=1
        fi
    elif [[ "$CONTAINER_VERSION" != "$LATEST_NUMERIC" ]]; then
        echo "A newer numeric version exists on the server: $LATEST_NUMERIC"
        read -p "Do you want to download the newest numeric version $LATEST_NUMERIC as latest? Y/n: " -r
        if [[ $REPLY =~ ^[Yy]$ || -z $REPLY ]]; then
            UPDATE_NEEDED=1
            CONTAINER_VERSION="$LATEST_NUMERIC"
            SIF_PATH="$APPTAINER_CACHEDIR/$IMAGE:latest.sif"
        else
            echo "Continuing with requested version $CONTAINER_VERSION."
        fi
    fi
fi

# ----------------------------
# Pull the container if needed
# ----------------------------
if [[ $UPDATE_NEEDED -eq 1 ]]; then
    REMOTE_IMAGE="oras://$REGISTRY/scipion/$IMAGE:$LATEST_NUMERIC"
    TMP_SIF="$SIF_PATH.tmp"

    # Pull the container
    echo "Downloading $LATEST_NUMERIC..."
    apptainer pull "$TMP_SIF" "$REMOTE_IMAGE"
    mv "$TMP_SIF" "$SIF_PATH"

    # Clean ORAS cache for this image only
    ORAS_DIR="$APPTAINER_CACHEDIR/cache/oras"
    if [[ -d "$ORAS_DIR" ]]; then
        echo "Cleaning ORAS cache for $IMAGE:$LATEST_NUMERIC..."
        find "$ORAS_DIR" -type f -name "sha256*" -exec rm -f {} \;
    fi

    # Save numeric tag if latest
    if [[ "$CONTAINER_VERSION" == "latest" || "$SIF_PATH" == *"latest.sif" ]]; then
        echo "$LATEST_NUMERIC" > "$VERSION_FILE"
    fi

    # Log the download
    echo "$(date '+%Y-%m-%d %H:%M:%S') | $CONTAINER_FLAVOUR | $LATEST_NUMERIC | latest=$LATEST_NUMERIC" >> "$LOG_FILE"

    echo "Downloaded version $LATEST_NUMERIC as $SIF_PATH."
fi

# ----------------------------
# Start (or reuse) the persistent instance
# ----------------------------
INSTANCE_RUNNING=0
if apptainer instance list "$INSTANCE_NAME" 2>/dev/null | awk 'NR>1 {print $1}' | grep -qx "$INSTANCE_NAME"; then
    INSTANCE_RUNNING=1
fi

if [[ $INSTANCE_RUNNING -eq 1 && $UPDATE_NEEDED -eq 1 ]]; then
    echo "A newer image was just downloaded, but instance '$INSTANCE_NAME' is still running the old one."
    read -p "Stop it and start a fresh instance with the new image? Y/n: " -r
    if [[ $REPLY =~ ^[Yy]$ || -z $REPLY ]]; then
        apptainer instance stop "$INSTANCE_NAME"
        INSTANCE_RUNNING=0
    fi
fi

if [[ $INSTANCE_RUNNING -eq 0 ]]; then
    echo "Starting persistent Scipion instance '$INSTANCE_NAME' for $CONTAINER_FLAVOUR"
    # shellcheck disable=SC2086
    apptainer instance start --nv --containall \
                --env SCIPION_USER_DATA=$SCIPION_PROJDIR \
                --env DISPLAY=$DISPLAY \
                --bind $SCIPION_PROJDIR/logs:/logs \
                --bind /run --bind /etc/resolv.conf \
                --bind /tmp/.X11-unix \
                --bind $SCIPION_DATADIR:/data --bind $SCIPION_PROJDIR \
                $SCIPCRYOSPARC_CMD $SCIPCRYOASSESS_CMD $SCIPPHENIX_CMD $SCIPSLURM_CMD $SCIPMPI_CMD $SCIPCHIMERA_CMD \
                "$SIF_PATH" "$INSTANCE_NAME"
else
    echo "Reusing already-running instance '$INSTANCE_NAME'."
fi

# ----------------------------
# Run the requested command inside the instance
# ----------------------------
# Note: this 'exec' returning does NOT stop the instance (unlike a plain
# 'apptainer exec <image>'), so background processes started inside it (e.g.
# the Scipion scheduler) keep running. Stop the instance explicitly with:
#   bash launcher.sh --stop-instance
#
# IMPORTANT: 'apptainer exec instance://name' does NOT inherit the --env
# variables passed to 'apptainer instance start' (those only apply to the
# instance's own startup process) - bind mounts persist across execs, but
# environment variables must be re-specified on every exec. Without
# SCIPION_USER_DATA here, Scipion silently falls back to its default
# $HOME/ScipionUserData, which under --containall is an ephemeral ~64MB
# tmpfs (not the real, bound project directory) - projects "run" there and
# vanish the moment the instance stops.
#
# LD_LIBRARY_PATH is set via 'export' inside the exec'd shell (not --env)
# so it APPENDS to whatever the container already has, instead of replacing
# it outright - only the known-missing libgfortran dir is added on top.
echo "Running inside Scipion instance '$INSTANCE_NAME'"
apptainer exec \
    --env SCIPION_USER_DATA=$SCIPION_PROJDIR \
    --env DISPLAY=$DISPLAY \
    --env PARALLEL_COMMAND_RELION="$SCIP_PARALLEL_COMMAND_RELION" \
    --env LD_PRELOAD="$SCIP_LD_PRELOAD_NVIDIA" \
    --env SCIP_EXTRA_LD_LIBRARY_PATH="$SCIP_EXTRA_LD_LIBRARY_PATH" \
    instance://"$INSTANCE_NAME" \
    bash -c 'export LD_LIBRARY_PATH="$SCIP_EXTRA_LD_LIBRARY_PATH:$LD_LIBRARY_PATH"; exec /scipion/scipion3 "$@"' _ "$@"
