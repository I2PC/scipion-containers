#!/bin/bash

# Scipion Containers launcher script for end users and system administrators
# Authors:
#   Mikel Iceta @ CNB-CSIC - miceta@cnb.csic.es
#   Lola Sánchez @ CNB-CSIC - md.sanchez@cnb.csic.es
#

#### USER CONFIGURABLE VARIABLES
###
###

# Available flavours are: base, spa
# You can build multiple containers by adding them separated by a space
# For example, CONTAINER_FLAVOURS="base spa"
# Remember that you will need base for any container
CONTAINER_FLAVOURS="base spa"
CONTAINER_VERSION="latest"

### CLUSTER SPECIFIC
# You can add your cluster-specific commands here
#PREPARE_ENV="module load XXX"
PREPARE_SCREEN="xhost +"
CLUSTER_PREP="$PREPARE_ENV $PREPARE_SCREEN"
$CLUSTER_PREP

### Apptainer directories configuration
# Define where Apptainer stores data:
#  - APPTAINER_TMPDIR: directory for temporary files created during image builds
#  - APPTAINER_CACHEDIR: base directory where Apptainer will create its internal cache folder (e.g. ~/containers)
export APPTAINER_TMPDIR="/path/to/your/apptainer/tmp"
export APPTAINER_CACHEDIR="/path/to/your/apptainer/cache"

# Create directories if they don’t exist
mkdir -p "$APPTAINER_TMPDIR" "$APPTAINER_CACHEDIR" "./build"

###
###
#### END OF USER CONFIGURABLE VARIABLES

echo "Preparing to build Scipion Apptainer image locally..."
echo "Getting latest version from GitHub..."
git pull
echo "System will build $CONTAINER_FLAVOURS"

for F in $CONTAINER_FLAVOURS; do
    TARGET="apptainer-$F"
    echo "Compiling $TARGET image..."
    echo "Result will be in ./build/$TARGET.sif"
    APPTAINERENV_DISPLAY=$DISPLAY apptainer build --nv --force --tmpdir $APPTAINER_TMPDIR "./build/$TARGET.sif" "./apptainer/$TARGET.def"
    # make a link in cache dir that will be used to check for updates when tha container is launched
    ln -s "$(realpath "./build/$TARGET.sif")" "$APPTAINER_CACHEDIR/$TARGET:$CONTAINER_VERSION.sif"
done

echo "Finished."