BootStrap: localimage
From: build/apptainer-base.sif

%labels
  Maintainer1 miceta@cnb.csic.es
  Maintainer2 jjimenez@cnb.csic.es
  Maintainer3 ja.moraleda@cnb.csic.es
  Version 26.03.31

%help
  Tomography package add-on for Apptainer/Singularity base image

%post
export DEBIAN_FRONTEND=noninteractive

# relion
apt-get update

echo ". /opt/miniforge3/etc/profile.d/conda.sh" >> $SINGULARITY_ENVIRONMENT
echo 'export PATH="/opt/miniforge3/bin:${PATH}"' >> $SINGULARITY_ENVIRONMENT
. /opt/miniforge3/etc/profile.d/conda.sh
export PATH="/opt/miniforge3/bin:${PATH}"

/scipion/scipion3 installp -p scipion-em-tomo
/scipion/scipion3 installp -p scipion-em-xmipptomo
/scipion/scipion3 installp -p scipion-em-imod

# Dynamo install
wget -nv -c -O /scipion/software/em/dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR.tar.part https://scipion.cnb.csic.es/downloads/scipion/software/em/dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR.tar
mv -v /scipion/software/em/dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR.tar.part /scipion/software/em/dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR.tar
mkdir /scipion/software/em/dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR
cd /scipion/software/em
tar -xf dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR.tar -C dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR
cd /scipion/software/em/dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR
bash ./dynamo_setup_linux.sh 
cd cuda
bash ./config.sh /usr/local/cuda
make all
make motors
make extended
touch cuda_compiled
cd
unlink /scipion/software/em/dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR/MCRLinux/sys/os/glnxa64/libstdc++.so.6
ln -s /usr/lib/x86_64-linux-gnu/libstdc++.so.6 /scipion/software/em/dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR/MCRLinux/sys/os/glnxa64/libstdc++.so.6
ln -s /scipion/software/em/dynamo-v-1.1.532_MCR-9.9.0_GLNXA64_withMCR /scipion/software/em/dynamo-1.1.532

/scipion/scipion3 installp -p scipion-em-dynamo --noBin

# Warp manual installation
mamba create -n warp-2.0.0 warp=2.0.0dev31 -c warpem -c nvidia/label/cuda-11.8.0 -c pytorch -c conda-forge

#conda create -n warp-2.0.0 python=3.11
#mamba install -n warp-2.0.0 https://anaconda.org/warpem/warp/2.0.0dev31/download/linux-64/warp-2.0.0dev31-py311_0.tar.bz2
#mamba install -n warp-2.0.0 nvidia/label/cuda-11.8.0
/scipion/scipion3 installp -p scipion-em-warp --noBin

# Regular installation plugins
/scipion/scipion3 installp -p scipion-em-aretomo
/scipion/scipion3 installp -p scipion-em-cistem
/scipion/scipion3 installp -p scipion-em-cryocare
/scipion/scipion3 installp -p scipion-em-deepfinder
/scipion/scipion3 installp -p scipion-em-eman2
/scipion/scipion3 installp -p scipion-em-emantomo
/scipion/scipion3 installp -p scipion-em-fidder
/scipion/scipion3 installp -p scipion-em-membrain
/scipion/scipion3 installp -p scipion-em-motioncorr
/scipion/scipion3 installp -p scipion-em-novactf
/scipion/scipion3 installp -p scipion-em-sphire
/scipion/scipion3 installp -p scipion-em-tardis
/scipion/scipion3 installp -p scipion-em-tomo3d
/scipion/scipion3 installp -p scipion-em-tomosegmemtv

# FAILING PLUGINS
#/scipion/scipion3 installp -p scipion-em-gapstop FALLA 

