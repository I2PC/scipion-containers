BootStrap: localimage
From: apptainer-base.sif

%labels
  Maintainer miceta@cnb.csic.es
  version 26.01.28

%help
  Tomography package add-on for Apptainer/Singularity base image

%post
export DEBIAN_FRONTEND=noninteractive

# relion
apt-get update
apt-get install -y --no-install-recommends --no-install-suggests build-essential mpi-default-bin mpi-default-dev libtiff-dev libpng-dev ghostscript libxft-dev

/scipion/scipion3 installp -p scipion-em-tomo
/scipion/scipion3 installp -p scipion-em-xmipptomo
/scipion/scipion3 installp -p scipion-em-imod

/scipion/scipion3 installp -p scipion-em-aretomo
/scipion/scipion3 installp -p scipion-em-cistem
/scipion/scipion3 installp -p scipion-em-cryocare
/scipion/scipion3 installp -p scipion-em-deepfinder
/scipion/scipion3 installp -p scipion-em-dynamo
/scipion/scipion3 installp -p scipion-em-eman2
/scipion/scipion3 installp -p scipion-em-emantomo
/scipion/scipion3 installp -p scipion-em-fidder
/scipion/scipion3 installp -p scipion-em-gapstop
/scipion/scipion3 installp -p scipion-em-membrain
/scipion/scipion3 installp -p scipion-em-motioncorr
/scipion/scipion3 installp -p scipion-em-novactf
/scipion/scipion3 installp -p scipion-em-relion
/scipion/scipion3 installp -p scipion-em-reliontomo
/scipion/scipion3 installp -p scipion-em-sphire
/scipion/scipion3 installp -p scipion-em-tardis
/scipion/scipion3 installp -p scipion-em-tomo3d
/scipion/scipion3 installp -p scipion-em-tomosegmemtv
/scipion/scipion3 installp -p scipion-em-warp
