Bootstrap:docker
# For --nv GPU use the container glibc must be >= the HOST glibc: --nv injects the
# host's driver + GLVND libs (built against the host glibc) into the container, and
# glibc is backward- but not forward-compatible. A 22.04 base (glibc 2.35) therefore
# breaks OpenGL on 24.04 hosts ("GLIBC_2.38 not found", e.g. ChimeraX on cori). So we
# build on the newest supported host OS (24.04); it stays backward-compatible to
# 20.04/22.04 hosts. 24.04 ships only CUDA >= 12.6, so this bumps CUDA 12.4 -> 12.6
# (runs on driver >= 525.60 via CUDA minor-version compatibility; cori's 550 is fine).
From:nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04
#From:nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04   # prev base; breaks GL on 24.04 hosts
#From:nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04   # needs driver ~570+, too new for 550
#From:nvidia/cuda:12.2.2-cudnn8-devel-ubuntu22.04

%labels
  Maintainer1 miceta@cnb.csic.es
  Maintainer2 jjimenez@cnb.csic.es
  Maintainer3 jamoraleda@cnb.csic.es
  Version 02.10.26

%help
  Base recipe for Scipion on Apptainer/Singularity image generation.

%environment
  # Add cuda lib to path
  export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$LD_LIBRARY_PATH"
  export QT_X11_NO_MITSHM=1
  export XDG_RUNTIME_DIR=/tmp/runtime-$USER
  export LIBGL_ALWAYS_INDIRECT=0

%post
# Export tz for apt so it does not block on install
export TZ=UTC
export DEBIAN_FRONTEND=noninteractive
# Add cuda lib to path
export LD_LIBRARY_PATH="/usr/local/cuda/lib64:$LD_LIBRARY_PATH"
# Create a symbolic link so that /usr/local/cuda points to the CUDA 12.6 installation
ln -s /usr/local/cuda-12.6 /usr/local/cuda

# Dependencies
apt update
# Utilities
apt install -y --no-install-recommends --no-install-suggests curl git less nano gedit vim wget python3-numpy python3-dev gawk bison flex unzip
# Compilation
apt install -y --no-install-recommends --no-install-suggests gcc-10 g++-10 make cmake scons default-jdk rsync
# Xmipp + Scipion libraries
apt install -y --no-install-recommends --no-install-suggests libfftw3-dev libhdf5-dev libopenmpi-dev libsqlite3-dev libtiff5-dev
# Slurm libraries
apt install -y --no-install-recommends --no-install-suggests libmunge-dev libmunge2 munge
#apt install -y --no-install-recommends --no-install-suggests unzip build-essential fakeroot devscripts equivs libjwt-dev libgtk2.0-dev libhwloc-dev libbpf-dev libdbus-1-dev libmunge-dev libmunge2 munge libyaml-0-2 libyaml-dev libjson-c-dev libhttp-parser-dev python-is-python3
# ChimeraX libraries
# NOTE: libxcb-cursor0 is required by the Qt xcb platform plugin from Qt >= 6.5.0
# (ChimeraX >= 1.6 bundles PyQt6/Qt 6.5+). Without it the bundled ChimeraX fails
# with "no Qt platform plugin could be initialized" even though 'xcb' is listed.
apt-get install -y xcb libffi-dev libxcb1-dev libxcb-cursor0 libxkbfile-dev qtbase5-dev libglu1-mesa libcanberra-gtk-module libcanberra-gtk3-module packagekit-gtk3-module

# Create a user for SLURM
adduser slurm

# Miniforge installation
wget -q "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-$(uname)-$(uname -m).sh" -O miniforge.sh
bash miniforge.sh -b -p /opt/miniforge3
rm miniforge.sh
ln -s /opt/miniforge3/etc/profile.d/conda.sh /etc/profile.d/conda.sh
echo ". /opt/miniforge3/etc/profile.d/conda.sh" >> $SINGULARITY_ENVIRONMENT
echo 'export PATH="/opt/miniforge3/bin:${PATH}"' >> $SINGULARITY_ENVIRONMENT
. /opt/miniforge3/etc/profile.d/conda.sh
export PATH="/opt/miniforge3/bin:${PATH}"

# Python version for the Scipion conda environment. Used by the installer and by
# the CPython lock / NumPy reinstall steps below — keep all three in sync here.
PYTHON_VERSION=3.11

# Scipion installation
conda run -n base pip3 install --user scipion-installer scons numpy
conda run -n base python3 -m scipioninstaller -conda -noAsk /scipion -python ${PYTHON_VERSION}
/scipion/scipion3 run conda install -c conda-forge libstdcxx-ng

# Scipion configuration
printf "\n\n" | /scipion/scipion3 config --overwrite;
sleep 5
echo "CUDA = True\n" >> /scipion/config/scipion.conf
echo "CUDA_BIN = /usr/local/cuda-12.6/bin\n" >> /scipion/config/scipion.conf
echo "CUDA_LIB = /usr/local/cuda-12.6/lib64\n" >> /scipion/config/scipion.conf
echo "OPENCV = False\n" >> /scipion/config/scipion.conf
# Fix for ScipionUserData folder problems
sed -i '/^SCIPION_LOG/d' /scipion/config/scipion.conf
sed -i '/^SCIPION_LOGS/d' /scipion/config/scipion.conf
sed -i '/^SCIPION_USER_DATA/d' /scipion/config/scipion.conf
echo "SCIPION_LOG = ${SCIPION_USER_DATA}/logs/scipion.log" >> /scipion/config/scipion.conf
echo "SCIPION_LOGS = ${SCIPION_USER_DATA}/logs" >> /scipion/config/scipion.conf

# Scipion font fix and explicitly locks Python to CPython to prevent the Conda dependency solver decides the "best" way to resolve the environment is to entirely uninstall standard Python (cpython) and replace it with graalpy
/scipion/scipion3 run "conda install -y -c conda-forge tk=*=xft_* python=${PYTHON_VERSION}.*=*cpython*"

# GraalPy (the Python implementation for GraalVM) often has compatibility issues with libraries that rely on C extensions, such as NumPy.
# (/opt/miniforge3/envs/scipion3/lib/jvm/graalvm.../languages/python/...)
# To fix this, you should force a reinstallation of NumPy in your environment so that the correct standard CPython version is downloaded and/or compiled.
/scipion/scipion3 run conda install -y --force-reinstall -c conda-forge numpy=1.24.4 python=${PYTHON_VERSION}.*=*cpython*

# Basic programs:
# Xmipp: if the installation fails, it finds the CMakeError.log and prints it on the terminal
/scipion/scipion3 installp -p scipion-em-xmipp -j "$(nproc)" || (find . -name "CMakeError.log" -exec cat {} + && exit 1)
# ChimeraX for visualisation (installing only the Chimera plugin)
/scipion/scipion3 pip install scipion-em-chimera
# /scipion/scipion3 installb deepLearningToolkit

ln -s /usr/lib/x86_64-linux-gnu/libffi.so /usr/lib/x86_64-linux-gnu/libffi.so.6

# Install a collector that prints this image's installed program versions
# (Scipion stack + system). build.sh runs it after the build and appends the
# output to build/apptainer-<flavour>-version, so each version file records the
# exact stack the image ships. It queries the live image, so flavours that
# inherit it from base report their own full plugin set.
cat > /opt/print-image-versions.sh <<'VEOF'
#!/bin/sh
echo "[system]"
( . /etc/os-release 2>/dev/null && echo "OS: $PRETTY_NAME" )
echo "CUDA: $(readlink -f /usr/local/cuda 2>/dev/null | sed 's#.*/##')"
echo "Python: $(python3 --version 2>&1)"
echo "Conda: $(conda --version 2>/dev/null)"
echo
echo "[scipion core]"
/scipion/scipion3 version 2>/dev/null
echo
echo "[scipion / xmipp packages]"
/scipion/scipion3 pip list 2>/dev/null | grep -iE 'scipion|xmipp' | sort
VEOF
chmod +x /opt/print-image-versions.sh

# Cleaning tasks for space optimisation
apt clean
apt autoclean
apt autoremove
rm -rf /var/lib/apt/lists/*
unset DEBIAN_FRONTEND

%runscript